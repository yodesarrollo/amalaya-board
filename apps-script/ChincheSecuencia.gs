/* Shared sequence contract; no public URLs or permission changes. Call only after native authorization. */
function nativeHash_(text){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,text,Utilities.Charset.UTF_8).map(function(b){return ('0'+(b&255).toString(16)).slice(-2);}).join('');}
function nativeSequenceFile_(rootId,id){var root=DriveApp.getFolderById(rootId),files=root.getFilesByName('chinche-sequence-'+id+'.json'),file=null;while(files.hasNext()){if(file)throw Error('Archivo duplicado; revisar integridad.');file=files.next();}return file;}
function nativeSequenceSave_(rootId,id,owner,sequence,expected){nativeValidate_(sequence);var data=JSON.stringify(sequence),hash=nativeHash_(data);if(hash!==expected)throw Error('Huella de secuencia no válida.');var f=nativeSequenceFile_(rootId,id);if(f){var old=JSON.parse(f.getBlob().getDataAsString());if(old.owner!==owner||old.hash!==hash||nativeHash_(JSON.stringify(old.sequence))!==hash)throw Error('Conflicto de secuencia.');}else f=DriveApp.getFolderById(rootId).createFile(Utilities.newBlob(JSON.stringify({v:1,id:id,owner:owner,hash:hash,sequence:sequence}),'application/json','chinche-sequence-'+id+'.json'));var saved=JSON.parse(f.getBlob().getDataAsString());if(saved.hash!==hash||nativeHash_(JSON.stringify(saved.sequence))!==hash)throw Error('No se confirmó la secuencia.');return {v:1,hash:hash,owner:owner};}
function nativeSequenceRead_(rootId,id,expected){var f=nativeSequenceFile_(rootId,id);if(!f)throw Error('Falta la secuencia.');var p=JSON.parse(f.getBlob().getDataAsString());if(p.id!==id||p.hash!==expected||nativeHash_(JSON.stringify(p.sequence))!==expected)throw Error('Integridad no confirmada.');return {id:id,hash:p.hash,sequence:p.sequence};}
function nativeValidate_(s){
 if(!s||s.v!==1||!Number.isFinite(s.duration)||s.duration<0||s.duration>600000+10000||!Number.isInteger(s.width)||!Number.isInteger(s.height)||s.width<1||s.width>2560||s.height<1||s.height>2560||!Array.isArray(s.events)||s.events.length>10000||!Array.isArray(s.frames)||s.frames.length>240)throw Error('Secuencia inválida');
 if(!/^data:image\/jpeg;base64,[A-Za-z0-9+/]+=*$/.test(s.base))throw Error('Base visual inválida');
 let last=-1,points=0;
 for(const e of s.events){if(!Number.isFinite(e.t)||e.t<last||e.t>s.duration||!['stroke','undo','audio-start','audio-end'].includes(e.type))throw Error('Reloj inválido');last=e.t;
  if(e.type==='stroke'){if(!['pen','marker','line','arrow','rect','ellipse'].includes(e.tool)||!/^#[a-f0-9]{6}$/i.test(e.color)||!Number.isFinite(e.width)||e.width<1||e.width>80||!Array.isArray(e.points)||!e.points.length)throw Error('Trazo inválido');let pt=e.t;for(const p of e.points){if(!Array.isArray(p)||p.length!==4||p.some(n=>!Number.isFinite(n))||p[0]<0||p[0]>s.width||p[1]<0||p[1]>s.height||p[2]<pt||p[2]>s.duration||p[3]<0||p[3]>1)throw Error('Punto inválido');pt=p[2];}points+=e.points.length;}}
 if(points>120000)throw Error('Demasiados puntos');
 let ft=-1;for(const f of s.frames){if(!Number.isFinite(f.t)||f.t<ft||f.t>s.duration||!/^data:image\/jpeg;base64,[A-Za-z0-9+/]+=*$/.test(f.image))throw Error('Captura inválida');ft=f.t;}
 if(s.audio&&(!Number.isFinite(s.audio.offset)||s.audio.offset<0||s.audio.offset>s.duration||!/^audio\/(webm|mp4|ogg)(;codecs=[a-zA-Z0-9., -]+)?$/.test(s.audio.mime)||!/^data:audio\/(webm|mp4|ogg)(;codecs=[a-zA-Z0-9., -]+)?;base64,[A-Za-z0-9+/]+=*$/.test(s.audio.data)))throw Error('Audio inválido');
 if(Utilities.newBlob(JSON.stringify(s)).getBytes().length>12000000)throw Error('La grabación supera 12 MB; conserva el original');return s;
}
